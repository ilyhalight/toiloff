---
interface Props {
  title: string;
  description: string;
  extraContent?: string;
}

const { title, description, extraContent } = Astro.props;
---

<header class="section-hero">
  <div class="section-hero__content">
    <h2 class="section-hero__title">{title}</h2>
    <p class="section-hero__description">
      {description}
    </p>
  </div>
  {extraContent && <div class="section-hero__extra">{extraContent}</div>}
</header>

<style>
  .section-hero {
    display: flex;
    flex-wrap: wrap;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.5rem;
    background: var(--surface-bg);
  }

  .section-hero__content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .section-hero__title {
    font-size: clamp(3rem, 9vw, 6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .section-hero__description {
    max-width: 44rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
  }
</style>
