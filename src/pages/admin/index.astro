---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import SectionHero from "../../components/Section/SectionHero.astro";
import SectionWrapper from "../../components/Section/SectionWrapper.astro";
import { AUTH_LOGIN_PAGE } from "../../lib/api/auth";
import Stats from "../../components/Stats/Stats.astro";
import AdminIndexActions from "../../components/Admin/AdminIndexActions.svelte";
import { BackendAPI } from "../../lib/api";
import { DEFUALT_DATA } from "../../lib/api/stats";

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect(AUTH_LOGIN_PAGE);
}

const statsData = await BackendAPI.stats.load().catch(() => DEFUALT_DATA);
---

<Layout title="Admin">
  <SectionWrapper>
    <SectionHero
      title="Dashboard"
      description={`Welcome back, ${user.username}!`}
    />
    <Stats statsData={statsData} />
    <AdminIndexActions client:load />
  </SectionWrapper>
</Layout>
