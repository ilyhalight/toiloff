---
export const prerender = false;

import SectionHero from "../../../../components/Section/SectionHero.astro";
import SectionWrapper from "../../../../components/Section/SectionWrapper.astro";
import AdminDeleteProjectForm from "../../../../components/Admin/AdminDeleteProjectForm.svelte";
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumbs, {
  type Breadcrumb,
} from "../../../../components/Breadcrumbs/Breadcrumbs.svelte";

import { AUTH_LOGIN_PAGE } from "../../../../lib/api/auth";
import { getPageProject } from "./index";

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect(AUTH_LOGIN_PAGE);
}

const { projectId } = Astro.params;
const project = await getPageProject(projectId);
if (project instanceof Response) {
  return project;
}

const breadcrumbs: Breadcrumb[] = [
  {
    title: "Admin",
    href: "/admin",
  },
  {
    title: "Projects",
    href: "/admin/projects",
  },
  {
    title: "Delete",
    href: `/admin/projects/${projectId}/delete`,
  },
];
---

<Layout title="Admin projects">
  <Breadcrumbs {breadcrumbs} />
  <SectionWrapper>
    <SectionHero
      title="Delete project"
      description="Permanently remove a project"
    />
    <AdminDeleteProjectForm {project} client:load />
  </SectionWrapper>
</Layout>
