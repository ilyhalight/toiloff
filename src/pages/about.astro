---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import AboutCard from "../components/About/AboutCard.astro";
import AboutSocialItem from "../components/About/AboutSocialItem.astro";
import Layout from "../layouts/Layout.astro";
import TelegramIcon from "../components/Icones/TelegramIcon.svelte";
import XIcon from "../components/Icones/XIcon.astro";
import EmailIcon from "../components/Icones/EmailIcon.astro";
import GithubFillIcon from "../components/Icones/GithubFillIcon.astro";
import LastfmIcon from "../components/Icones/LastfmIcon.astro";
import MangalibIcon from "../components/Icones/MangalibIcon.astro";
import ShikimoriIcon from "../components/Icones/ShikimoriIcon.astro";
import SteamIcon from "../components/Icones/SteamIcon.astro";
import VKIcon from "../components/Icones/VKIcon.svelte";
import TypeScriptColorIcon from "../components/Icones/TypeScriptColorIcon.astro";
import JavaScriptColorIcon from "../components/Icones/JavaScriptColorIcon.astro";
import PythonColorIcon from "../components/Icones/PythonColorIcon.astro";
import AstroIcon from "../components/Icones/AstroColorIcon.astro";
import ElysiaIcon from "../components/Icones/ElysiaColorIcon.astro";
import SvelteIcon from "../components/Icones/SvelteColorIcon.astro";
import NuxtIcon from "../components/Icones/NuxtColorIcon.astro";
import VueIcon from "../components/Icones/VueColorIcon.astro";
import PostgreSQLIcon from "../components/Icones/PostgreSQLColorIcon.astro";
import RedisIcon from "../components/Icones/RedisColorIcon.astro";
import S3Icon from "../components/Icones/S3ColorIcon.astro";
import GitIcon from "../components/Icones/GitColorIcon.astro";
import BunIcon from "../components/Icones/BunColorIcon.astro";
import WebpackIcon from "../components/Icones/WebpackColorIcon.astro";
import MySQLIcon from "../components/Icones/MySQLColorIcon.astro";
import NginxColorIcon from "../components/Icones/NginxColorIcon.astro";
import DockerColorIcon from "../components/Icones/DockerColorIcon.astro";
import NodeColorIcon from "../components/Icones/NodeColorIcon.astro";
import GenericIcon from "../components/Icones/GenericIcon.astro";
import ChevronRightIcon from "../components/Icones/ChevronRightIcon.svelte";

import SectionHero from "../components/Section/SectionHero.astro";
import SectionWrapper from "../components/Section/SectionWrapper.astro";
import Breadcrumbs from "../components/Breadcrumbs/Breadcrumbs.svelte";

import { daysBetween } from "../lib/utils";
import EyesEmojiImage from "../assets/emojis/U+1F440_1.webp";

const socialIcons = {
  "telegram": TelegramIcon,
  "github": GithubFillIcon,
  "x": XIcon,
  "steam": SteamIcon,
  "shikimori": ShikimoriIcon,
  "mangalib": MangalibIcon,
  "lastfm": LastfmIcon,
  "vk": VKIcon,
  "email": EmailIcon,
  "other": GenericIcon
} as const

const skillIcons = {
  typescript: TypeScriptColorIcon,
  javascript: JavaScriptColorIcon,
  bun: BunIcon,
  elysia: ElysiaIcon,
  svelte: SvelteIcon,
  postgresql: PostgreSQLIcon,
  redis: RedisIcon,
  nginx: NginxColorIcon,
  docker: DockerColorIcon,
  astro: AstroIcon,
  nuxt: NuxtIcon,
  vue: VueIcon,
  python: PythonColorIcon,
  s3: S3Icon,
  git: GitIcon,
  webpack: WebpackIcon,
  node: NodeColorIcon,
  mysql: MySQLIcon,
} as const;

const socials = (await getCollection("socials"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data)
const skills = (await getCollection("skills"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data)

const currentDate = new Date();
const currentYear = currentDate.getFullYear();
const birthdayDate = new Date(`${currentYear}-09-14T23:59:59`);
if (currentDate > birthdayDate) {
  birthdayDate.setFullYear(currentYear + 1);
}
const birthdayIn = daysBetween(currentDate.getTime(), birthdayDate.getTime());
---

<Layout title="About">
  <Breadcrumbs
    breadcrumbs={[
      { title: "Home", href: "/" },
      { title: "About", href: "/about" },
    ]}
  />
  <SectionWrapper>
    <SectionHero title="About" description="Small info about me" />
    <ul class="about-list">
      <AboutCard title="WHOAMI" content="Ilya" subcontent="Fullstack dev" />
      {
        birthdayIn ? (
          <AboutCard
            title="BIRTHDAY"
            content="Sep 14"
            subcontent={`${birthdayIn} days away`}
          />
        ) : (
          <AboutCard
            title={
              <span class="birthday-today">
                <img
                  src="https://media.githubusercontent.com/media/saeedtahmtan/telemoji/refs/heads/main/webp/animated/U%2B1F382_1.webp"
                  alt=""
                />
                BIRTHDAY
              </span>
            }
            content="TODAY"
            subcontent="sep 14"
          />
        )
      }
      <AboutCard title="LOCATION" content="Russia" subcontent="& web" />
      <AboutCard
        title="FAV MUSIC"
        content="maybe hyperpop"
        subcontent="& indie pop, idk"
      />
      <AboutCard title="FAV EDITOR" content="VS CODE" subcontent="since 2020" />
      <AboutCard
        title="FAV LANG"
        content="TypeScript"
        subcontent="since 2024"
      />
      {
        birthdayIn === 0 && (
          <div class="birthday-effect">
            <img src="" alt="" />
          </div>
        )
      }
    </ul>
    <section class="about-section">
      <h3 class="about-section__title">Find me online</h3>
      <ul class="about-socials">
        {
          socials.map((social) => (
            <AboutSocialItem
              id={social.id}
              label={social.label}
              href={social.href}
              Icon={social.icon in socialIcons ? socialIcons[social.icon as keyof typeof socialIcons] : socialIcons["other"]}
            />
          ))
        }
      </ul>
    </section>
    <section class="about-section">
      <h3 class="about-section__title">Tech stack</h3>
      <ul class="tech-stack">
        {skills.map((skill) => {
          const Icon = skill.icon in skillIcons
            ? skillIcons[skill.icon as keyof typeof skillIcons]
            : undefined;
          return (
            <li class="tech-stack__item">
              {Icon && <Icon />} {skill.slug}
            </li>
          );
        })}
      </ul>
    </section>
    <a href="/donate" class="about-section donate-cta">
      <span class="donate-cta__text">
        <Image src={EyesEmojiImage} alt="" class="donate-cta__emoji" />
        Hi!! Want to support me?
      </span>
      <span class="donate-cta__chevron"><ChevronRightIcon /></span>
    </a>
  </SectionWrapper>
</Layout>

<script>
  import { tmAlert } from "../lib/alert";

  // btoa("<your_email>")
  const ENCODED_EMAIL = "dG9pbC5jb250YWN0QHlhbmRleC5jb20=";

  function main() {
    const emailItem = document.querySelector('[data-social="email"]');
    if (!emailItem) {
      return;
    }

    emailItem.addEventListener("click", async (e) => {
      e.preventDefault();
      await Promise.all([
        navigator.clipboard.writeText(atob(ENCODED_EMAIL)),
        tmAlert("Email address copied!"),
      ]);
    });
  }

  main();
</script>

<style>
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    gap: 0.75rem;
  }

  .tech-stack__item {
    background: var(--onsurface-bg);
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.tech-stack__item svg) {
    width: 20px;
    height: 20px;
  }

  .about-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .birthday-effect {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    left: -5%;
    top: 0;
  }

  .birthday-effect img {
    width: 100%;
  }

  .birthday-today {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .birthday-today img {
    max-width: 32px;
    width: 32px;
    max-height: 32px;
    height: 32px;
    object-fit: cover;
  }

  .about-section {
    background: var(--surface-bg);
    padding: 1rem 1.25rem;
    border-radius: 1rem;
  }

  .about-section__title {
    color: var(--text-muted);
    font-weight: 600;
    font-size: 1.5rem;
    text-transform: uppercase;
  }

  .about-socials {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    gap: 0.5rem;
  }

  .donate-cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 2rem;
    font-weight: 700;
    transition: background 0.25s ease;
  }

  .donate-cta:hover {
    background: var(--onsurface-hover-bg);
  }

  .donate-cta__emoji {
    width: 2.25rem;
    height: 2.25rem;
    object-fit: cover;
    display: inline-block;
    vertical-align: middle;
    top: -0.125rem;
    position: relative;
    margin-right: 0.5rem;
  }

  .donate-cta__text {
    flex: 1;
  }

  .donate-cta__chevron {
    display: flex;
  }

  @media screen and (max-width: 500px) {
    .about-section {
      width: 100%;
    }
    .about-list {
      overflow: hidden;
    }
  }
</style>

<script>
  const BIRTHDAY_EFFECT_URL =
    "https://media.githubusercontent.com/media/ilyhalight/telegram-emoji-effects/master/webp/U+31_U+20E3/2.webp";

  let isInitedEffect = false;

  function initEffect(imageEl: HTMLImageElement) {
    if (isInitedEffect || !imageEl) {
      return;
    }

    isInitedEffect = true;
    imageEl.src = `${BIRTHDAY_EFFECT_URL}?t=${Date.now()}`;
    imageEl.addEventListener(
      "load",
      () => {
        setTimeout(() => {
          if (!imageEl) {
            return;
          }

          imageEl.src = "";
          isInitedEffect = false;
        }, 2800);
      },
      { once: true },
    );
  }

  function main() {
    const birthdayEffectImg = document.querySelector<HTMLImageElement>(
      ".birthday-effect img",
    );
    const birthdayToday = document.querySelector(".birthday-today");
    if (!birthdayEffectImg) {
      return;
    }

    birthdayToday?.addEventListener("click", () => {
      initEffect(birthdayEffectImg);
    });

    initEffect(birthdayEffectImg);
  }

  main();
</script>
