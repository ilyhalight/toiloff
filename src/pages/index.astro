---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import PageSection from "../components/PageSection/PageSection.astro";
import ProjectsWrapper from "../components/Projects/ProjectsWrapper.svelte";
import Stats from "../components/Stats/Stats.astro";
import GuestbookContent from "../components/Guestbook/GuestbookContent.astro";
import SectionHero from "../components/Section/SectionHero.astro";
import SectionWrapper from "../components/Section/SectionWrapper.astro";
import { DEFUALT_DATA } from "../lib/api/stats";
import * as BFF from "../lib/api/bff";

const mainPageData = await BFF.getMainPage().catch(() => ({
  stats: DEFUALT_DATA,
  webring: null,
  projects: [],
}));
---

<Layout title="Home">
  <Hero webringData={mainPageData.webring} />
  <PageSection
    title="Projects"
    link={{
      href: "/projects",
      name: "View all",
    }}
  >
    <ProjectsWrapper projects={mainPageData.projects} />
  </PageSection>
  <PageSection title="Stats">
    <Stats statsData={mainPageData.stats} />
  </PageSection>

  <SectionWrapper>
    <SectionHero
      title="Guestbook"
      description="Leave a small message, or just say hi"
    />
    <GuestbookContent />
  </SectionWrapper>
</Layout>
